body {
    font-family: Arial, sans-serif;
    font-size: 18px;
    line-height: 1.6;
    margin: 0;
    background-color: #f4f6f8;
    color: #222;
}

header {
    background-color: #1f3b57;
    color: white;
    text-align: center;
    padding: 30px 20px;
}

.tagline {
    margin-top: 8px;
    font-size: 1rem;
}

nav {
    background-color: #2d567c;
    text-align: center;
    padding: 12px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    text-decoration: underline;
}

main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 30px 20px;
}

.hero {
    background-color: white;
    padding: 30px;
    border-radius: 10px;
    text-align: center;
    margin-bottom: 25px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.small-hero {
    padding: 20px;
}

.button {
    display: inline-block;
    margin-top: 15px;
    background-color: #1f3b57;
    color: white;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: 6px;
}

.button:hover {
    background-color: #163047;
}

.content-grid {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.card {
    background-color: white;
    flex: 1;
    min-width: 220px;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.image-section img {
    width: 100%;
    max-width: 100%;
    border-radius: 10px;
    display: block;
}

.tips-card ul {
    padding-left: 20px;
}

footer {
    background-color: #1f3b57;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 30px;
}
