* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: #f4f7fb;
    background:
        radial-gradient(circle at top left, rgba(0, 255, 200, 0.18), transparent 30%),
        radial-gradient(circle at top right, rgba(88, 101, 242, 0.20), transparent 28%),
        linear-gradient(135deg, #07111f, #0d1b2a 45%, #102a43 100%);
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
}

.site-header {
    padding: 60px 0 30px;
    text-align: center;
}

.site-header h1 {
    margin: 0;
    font-size: 2.8rem;
    letter-spacing: 1px;
    color: #ffffff;
    text-shadow: 0 0 14px rgba(0, 255, 200, 0.25);
}

.tagline {
    margin-top: 12px;
    font-size: 1.1rem;
    color: #c8d6e5;
}

.site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: rgba(7, 17, 31, 0.72);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.nav-links {
    display: flex;
    justify-content: center;
    gap: 28px;
    padding: 14px 0;
    flex-wrap: wrap;
}

.site-nav a {
    color: #f4f7fb;
    text-decoration: none;
    font-weight: bold;
    padding: 8px 14px;
    border-radius: 999px;
    transition: 0.3s ease;
}

.site-nav a:hover,
.site-nav a:focus {
    background-color: rgba(0, 255, 200, 0.15);
    color: #7fffd4;
}

.hero,
.page-banner,
.card,
.list-card,
.feature-image {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(10px);
}

.hero {
    margin: 34px 0 26px;
    padding: 48px 36px;
    text-align: center;
    overflow: hidden;
    position: relative;
}

.hero::before {
    content: "";
    position: absolute;
    width: 220px;
    height: 220px;
    background: rgba(0, 255, 200, 0.12);
    border-radius: 50%;
    top: -60px;
    left: -60px;
}

.hero::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    background: rgba(88, 101, 242, 0.16);
    border-radius: 50%;
    bottom: -50px;
    right: -40px;
}

.hero h2,
.page-banner h2,
.card h3 {
    color: #ffffff;
    position: relative;
    z-index: 1;
}

.hero p,
.page-banner p,
.card p,
.list-card li {
    color: #d9e4f2;
    position: relative;
    z-index: 1;
}

.button {
    display: inline-block;
    margin-top: 18px;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: bold;
    color: #07111f;
    background: linear-gradient(90deg, #00ffd0, #67e8f9);
    box-shadow: 0 8px 18px rgba(0, 255, 208, 0.24);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    z-index: 1;
}

.button:hover,
.button:focus {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(0, 255, 208, 0.3);
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 28px;
}

.card {
    padding: 24px;
    transition: transform 0.25s ease, border-color 0.25s ease;
}

.card:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 255, 200, 0.35);
}

.feature-image {
    overflow: hidden;
    margin-bottom: 32px;
    padding: 10px;
}

.feature-image img {
    width: 100%;
    display: block;
    border-radius: 14px;
}

.page-banner {
    margin: 34px 0 24px;
    padding: 30px;
    text-align: center;
}

.list-card {
    padding: 30px 36px;
    margin-bottom: 32px;
}

.list-card ul {
    margin: 0;
    padding-left: 22px;
}

.list-card li {
    margin-bottom: 12px;
}

.site-footer {
    margin-top: 36px;
    padding: 20px 0;
    text-align: center;
    background: rgba(7, 17, 31, 0.78);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #c8d6e5;
}

@media (max-width: 800px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 32px 22px;
    }

    .site-header h1 {
        font-size: 2.1rem;
    }
}
